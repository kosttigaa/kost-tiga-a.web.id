# Salin menjadi .env lalu isi. File .env tidak boleh di-commit.
PORT=5000
HOST=127.0.0.1

# Kata sandi login (username: admin dan penjaga). Akun tanpa kata sandi dinonaktifkan.
ADMIN_PASSWORD=
PENJAGA_PASSWORD=

# Kunci penanda token login. Isi string acak panjang, misalnya: openssl rand -hex 32
SESSION_SECRET=

# Opsional: lokasi file database SQLite (default: server/data/kost.db)
# DB_PATH=
